{
  "manifest_version": 3,
  "name": "iVirtual Wrap",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Interfaz limpia y moderna para iVirtual (Moodle) y los portales de ITSON. Corre en tu navegador, sobre tu propia sesión.",
  "author": "Oyzters",
  "homepage_url": "https://github.com/oyzters/iVirtual-Wrap",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "iVirtual Wrap",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ivirtual.itson.edu.mx/*",
    "https://apps9.itson.edu.mx/PortalSistemas*",
    "https://apps9.itson.edu.mx/eres*",
    "https://apps9.itson.edu.mx/MesaAyudaITSON/*",
    "https://apps11.itson.edu.mx/CalendarioEscolar/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ivirtual.itson.edu.mx/*",
        "https://apps9.itson.edu.mx/PortalSistemas*",
        "https://apps9.itson.edu.mx/eres*",
        "https://apps9.itson.edu.mx/MesaAyudaITSON/*"
      ],
      "js": [
        "src/storage.js",
        "src/enhance.js",
        "src/content.js"
      ],
      "css": [
        "src/base.css",
        "src/pages/login.css",
        "src/pages/dashboard.css",
        "src/pages/frontpage.css",
        "src/pages/recuperapassword.css",
        "src/pages/mesaayuda.css",
        "src/pages/portalsistemas.css",
        "src/pages/portalinicio.css",
        "src/pages/eres.css",
        "src/pages/calendarioescolar.css",
        "src/pages/coursesearch.css",
        "src/pages/profile.css",
        "src/pages/tables.css",
        "src/pages/forms.css",
        "src/pages/messaging.css",
        "src/pages/notifications.css",
        "src/pages/calendar.css",
        "src/pages/course.css",
        "src/pages/attendance.css",
        "src/pages/reportbuilder.css",
        "src/pages/chrome.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://apps11.itson.edu.mx/CalendarioEscolar/*"
      ],
      "js": [
        "src/storage.js",
        "src/enhance.js",
        "src/content.js"
      ],
      "css": [
        "src/base.css",
        "src/pages/login.css",
        "src/pages/dashboard.css",
        "src/pages/frontpage.css",
        "src/pages/recuperapassword.css",
        "src/pages/mesaayuda.css",
        "src/pages/portalsistemas.css",
        "src/pages/portalinicio.css",
        "src/pages/eres.css",
        "src/pages/calendarioescolar.css",
        "src/pages/coursesearch.css",
        "src/pages/profile.css",
        "src/pages/tables.css",
        "src/pages/forms.css",
        "src/pages/messaging.css",
        "src/pages/notifications.css",
        "src/pages/calendar.css",
        "src/pages/reportbuilder.css",
        "src/pages/chrome.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://apps11.itson.edu.mx/CalendarioEscolar/*"
      ],
      "js": [
        "src/page-combos.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
